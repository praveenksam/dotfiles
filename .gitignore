.DS_Store

# --- Claude Code runtime state ---
# Only settings.json, your own skills/, and project-init.zsh are worth
# versioning. Everything else is session data, caches, or reinstallable.
claude/.claude*/projects/
claude/.claude*/backups/
claude/.claude*/file-history/
claude/.claude*/cache/
claude/.claude*/image-cache/
claude/.claude*/tasks/
claude/.claude*/jobs/
claude/.claude*/telemetry/
claude/.claude*/history.jsonl
claude/.claude*/stats-cache.json
claude/.claude*/policy-limits.json
claude/.claude*/mcp-needs-auth-cache.json
claude/.claude*/remote-settings.json
claude/.claude*/.last-cleanup
claude/.claude*/.claude.json
claude/.claude*/.claude.json.backup.*

# Whole plugins tree, not just cache/. Marketplace plugins are reinstalled
# from settings.json's extraKnownMarketplaces — versioning them adds ~1,600
# files of vendored third-party code you never edit.
claude/.claude*/plugins/

# --- secrets ---
.env
*.pem
*.key
id_ed25519*
id_rsa*
**/.msmtp-pass
**/hosts.yml
**/profiles.yml

# --- editor / tool state ---
nvim/.config/nvim/lazy-lock.json
*.log

# --- dbt ---
**/target/
**/dbt_packages/
**/logs/
