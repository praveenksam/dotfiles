### [x] Task 7 — Create `src/components/InputBar.svelte`

Create `autom9-extension/src/components/InputBar.svelte`:

```svelte
<script lang="ts">
  import { chatStore } from '../stores/chat.svelte';
  import { sessionStore } from '../stores/session.svelte';
  import { apiFetch, ApiError } from '../lib/api';
  import type { Message } from '../stores/chat.svelte';

  let inputText = $state('');

  const isDisabled = $derived(chatStore.status === 'loading');

  async function handleSubmit() {
    const message = inputText.trim();
    if (!message || isDisabled) return;

    // Capture history before adding new user message
    const history: Message[] = chatStore.messages.map(m => ({ role: m.role, content: m.content }));

    // Optimistic update: add user message, transition to loading
    chatStore.messages = [...chatStore.messages, { role: 'user', content: message }];
    chatStore.status = 'loading';
    chatStore.error = null;
    inputText = '';

    try {
      const headers: Record<string, string> = {};
      if (sessionStore.sessionId) {
        headers['X-Autom9-Session'] = sessionStore.sessionId;
      }

      const response = await apiFetch<{ data: { reply: string }; meta: { request_id: string } }>(
        '/api/chat',
        {
          method: 'POST',
          headers,
          body: JSON.stringify({ message, history }),
        }
      );

      chatStore.messages = [
        ...chatStore.messages,
        { role: 'assistant', content: response.data.reply },
      ];
      chatStore.status = 'complete';
    } catch (err) {
      const msg =
        err instanceof ApiError
          ? err.message
          : 'Something went wrong. Please try again.';
      chatStore.error = msg;
      chatStore.status = 'error';
    }
  }

  function handleKeydown(e: KeyboardEvent) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSubmit();
    }
  }
</script>

<div class="input-bar">
  <textarea
    class="input-bar__textarea"
    placeholder="Ask the agent…"
    bind:value={inputText}
    disabled={isDisabled}
    rows={2}
    onkeydown={handleKeydown}
  ></textarea>
  <button
    class="input-bar__submit"
    onclick={handleSubmit}
    disabled={isDisabled}
    aria-label="Send message"
  >
    {isDisabled ? '…' : 'Send'}
  </button>
</div>

<style>
