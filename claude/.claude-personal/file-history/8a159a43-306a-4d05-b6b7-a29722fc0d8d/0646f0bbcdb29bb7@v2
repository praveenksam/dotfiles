async def test_fetch_open_work_billable_above_internal(monkeypatch):
    _configured(monkeypatch)
    doc = _make_doc([
        "Billable",
        "Project Alpha - 10 days",
        "Project Beta - 5 days",
        "Internal",
        "Internal Training - 2 days",
    ])
    mock_client = _mock_client_for(_token_ok(), _docs_ok(doc))

    with patch("app.integrations.google_docs.httpx.AsyncClient", return_value=mock_client):
        result = await GoogleDocsIntegration().execute("fetch_open_work", {"url": _DOCS_DOC_URL})

    opps = result["opportunities"]
    assert len(opps) == 3
    billable = [o for o in opps if o["type"] == "billable"]
    internal = [o for o in opps if o["type"] == "internal"]
    assert len(billable) == 2
    assert len(internal) == 1
    # Billable items appear before internal items in the returned list
    billable_indices = [i for i, o in enumerate(opps) if o["type"] == "billable"]
    internal_indices = [i for i, o in enumerate(opps) if o["type"] == "internal"]
    assert max(billable_indices) < min(internal_indices)


