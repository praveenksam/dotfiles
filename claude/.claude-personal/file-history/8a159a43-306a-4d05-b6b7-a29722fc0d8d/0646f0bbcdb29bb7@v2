# ---------------------------------------------------------------------------
# Token caching
# ---------------------------------------------------------------------------


async def test_token_cache_used_on_second_call(monkeypatch):
    _configured(monkeypatch)
    doc = _make_doc(["Billable", "Opp A"])
    token_call_count = 0
    post_urls: list[str] = []

    async def fake_post(url, **kwargs):
        nonlocal token_call_count
        post_urls.append(url)
        if "oauth2.googleapis.com" in url:
            token_call_count += 1
            return _token_ok()
        raise AssertionError("unexpected post")

    docs_response = _docs_ok(doc)
    mock_client = AsyncMock()
    mock_client.__aenter__ = AsyncMock(return_value=mock_client)
    mock_client.__aexit__ = AsyncMock(return_value=False)
    mock_client.post = fake_post
    mock_client.get = AsyncMock(return_value=docs_response)

    with patch("app.integrations.google_docs.httpx.AsyncClient", return_value=mock_client):
        integration = GoogleDocsIntegration()
        await integration.execute("fetch_open_work", {"url": _DOCS_DOC_URL})
        await integration.execute("fetch_open_work", {"url": _DOCS_DOC_URL})

    assert token_call_count == 1


async def test_token_refreshed_on_expiry(monkeypatch):
    _configured(monkeypatch)
    doc = _make_doc(["Billable", "Opp A"])
    token_call_count = 0

    async def fake_post(url, **kwargs):
        nonlocal token_call_count
        if "oauth2.googleapis.com" in url:
            token_call_count += 1
            return _token_ok()
        raise AssertionError("unexpected post")

    docs_response = _docs_ok(doc)
    mock_client = AsyncMock()
    mock_client.__aenter__ = AsyncMock(return_value=mock_client)
    mock_client.__aexit__ = AsyncMock(return_value=False)
    mock_client.post = fake_post
    mock_client.get = AsyncMock(return_value=docs_response)

    with patch("app.integrations.google_docs.httpx.AsyncClient", return_value=mock_client):
        integration = GoogleDocsIntegration()
        await integration.execute("fetch_open_work", {"url": _DOCS_DOC_URL})
        integration._token_expiry = time.monotonic() - 1.0  # force expiry
        await integration.execute("fetch_open_work", {"url": _DOCS_DOC_URL})

    assert token_call_count == 2
