def _para(text: str, *, style: str = "NORMAL_TEXT", bullet: bool = False) -> dict:
    """Build a single paragraph block with optional heading style or bullet marker."""
    p: dict = {
        "elements": [{"textRun": {"content": text + "\n"}}],
        "paragraphStyle": {"namedStyleType": style},
    }
    if bullet:
        p["bullet"] = {"listId": "kix.test"}
    return {"paragraph": p}


def _make_doc(blocks: list) -> dict:
    """Build a Google Docs API response body.

    Each item is either a string (NORMAL_TEXT paragraph) or a paragraph block
    dict produced by `_para()` for explicit style/bullet control.
    """
    content = []
    for b in blocks:
        if isinstance(b, str):
            content.append(_para(b))
        else:
            content.append(b)
    return {"body": {"content": content}}


def _token_ok() -> MagicMock:
    r = MagicMock()
    r.status_code = 200
    r.json.return_value = {"access_token": "tok", "expires_in": 3600}
    return r


def _docs_ok(doc: dict) -> MagicMock:
    r = MagicMock()
    r.status_code = 200
    r.json.return_value = doc
    return r


def _mock_client_for(post_responses, get_response=None):
    """Build a mock AsyncClient for httpx."""
    mock = AsyncMock()
    mock.__aenter__ = AsyncMock(return_value=mock)
    mock.__aexit__ = AsyncMock(return_value=False)
    if isinstance(post_responses, list):
        mock.post = AsyncMock(side_effect=post_responses)
    else:
        mock.post = AsyncMock(return_value=post_responses)
    if get_response is not None:
        mock.get = AsyncMock(return_value=get_response)
    return mock


