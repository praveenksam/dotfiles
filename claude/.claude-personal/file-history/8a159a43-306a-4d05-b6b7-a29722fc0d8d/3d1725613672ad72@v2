<script lang="ts">
  import { onMount } from 'svelte';
  import { apiFetch, ApiError } from '../lib/api';
  import { sessionStore } from '../stores/session.svelte';

  type LoadState = 'idle' | 'loading' | 'done' | 'error';

  interface OpportunityItem {
    title: string;
    type: 'billable' | 'internal';
    details: string;
  }

  let state = $state<LoadState>('idle');
  let opportunities = $state<OpportunityItem[]>([]);
  let errorMessage = $state<string | null>(null);

  const sessionHeaders = (): Record<string, string> =>
    sessionStore.sessionId ? { 'X-Autom9-Session': sessionStore.sessionId } : {};

  async function loadOpenWork(): Promise<void> {
    state = 'loading';
    try {
      const response = await apiFetch<{ data: OpportunityItem[] }>('/api/data/open-work', {
        headers: sessionHeaders(),
      });
      opportunities = response.data;
      state = 'done';
    } catch (err) {
      const msg =
        err instanceof ApiError
          ? err.message
          : err instanceof Error
            ? err.message
            : 'Could not load open work opportunities';
      errorMessage = msg;
      state = 'error';
    }
  }

  onMount(() => {
    loadOpenWork();
  });
</script>

<div class="open-work-panel">
  <section class="panel-section">
    <h3>Open Work Opportunities</h3>
    {#if state === 'loading'}
      <p class="loading">Loading…</p>
    {:else if state === 'error'}
      <p class="error">{errorMessage}</p>
    {:else if opportunities.length === 0}
      <p class="empty">No open work opportunities available</p>
    {:else}
      <ul>
        {#each opportunities as opp}
          <li class="opportunity">
            <span class="badge badge-{opp.type}">{opp.type === 'billable' ? 'Billable' : 'Internal'}</span>
            <span class="title">{opp.title}</span>
          </li>
        {/each}
      </ul>
    {/if}
  </section>
</div>

