# ---------------------------------------------------------------------------
# AC8 — log assertion: session_id + integration emitted, no opportunity titles
# ---------------------------------------------------------------------------


async def test_get_open_work_logs_session_and_integration_only(
    client: AsyncClient, monkeypatch, caplog
):
    """AC8: log contains session_id + integration='google_docs', no opportunity titles."""
    import app.api.data as data_module
    from app.config.workflow_registry import WorkflowRegistry

    registry = WorkflowRegistry()
    registry._active = {
        **_BASE_CONFIG,
        "open_work_board": {"google_docs_url": _OPEN_WORK_URL},
    }
    monkeypatch.setattr(data_module, "workflow_registry", registry)

    secret_title = "PII Project Alpha SecretClient"

    class _StubDocs:
        async def execute(self, action: str, params: dict) -> dict:
            return {
                "opportunities": [
                    {"title": secret_title, "type": "billable", "details": secret_title},
                ]
            }

    monkeypatch.setattr(data_module, "_google_docs", _StubDocs())

    with caplog.at_level(logging.INFO, logger="app.api.data"):
        response = await client.get("/api/data/open-work", headers=SESSION_HEADERS)
    assert response.status_code == 200

    fetch_records = [r for r in caplog.records if r.message == "data_open_work_fetch"]
    assert fetch_records, "expected a data_open_work_fetch log record"
    record = fetch_records[0]
    assert getattr(record, "session_id", None) == "test-session-id"
    assert getattr(record, "integration", None) == "google_docs"

    for r in caplog.records:
        assert secret_title not in r.getMessage()
        for value in vars(r).values():
            if isinstance(value, str):
                assert secret_title not in value


# ---------------------------------------------------------------------------
# Integration returns malformed type — endpoint must coerce, not 500
# ---------------------------------------------------------------------------


async def test_get_open_work_unknown_type_coerced_to_internal(client: AsyncClient, monkeypatch):
    """A malformed type from the integration must be coerced (not 500 the endpoint)."""
    import app.api.data as data_module
    from app.config.workflow_registry import WorkflowRegistry

    registry = WorkflowRegistry()
    registry._active = {
        **_BASE_CONFIG,
        "open_work_board": {"google_docs_url": _OPEN_WORK_URL},
    }
    monkeypatch.setattr(data_module, "workflow_registry", registry)

    class _StubDocs:
        async def execute(self, action: str, params: dict) -> dict:
            return {
                "opportunities": [
                    {"title": "Weird One", "type": "prospective", "details": ""},
                    {"title": "Null One", "type": None, "details": ""},
                ]
            }

    monkeypatch.setattr(data_module, "_google_docs", _StubDocs())

    response = await client.get("/api/data/open-work", headers=SESSION_HEADERS)
    assert response.status_code == 200
    items = response.json()["data"]
    assert {item["title"]: item["type"] for item in items} == {
        "Weird One": "internal",
        "Null One": "internal",
    }
