# ---------------------------------------------------------------------------
# GET /api/data/open-work — happy path: sorted billable first
# ---------------------------------------------------------------------------


async def test_get_open_work_returns_opportunities_sorted_billable_first(client: AsyncClient, monkeypatch):
    import app.api.data as data_module
    from app.config.workflow_registry import WorkflowRegistry

    registry = WorkflowRegistry()
    registry._active = {
        **_BASE_CONFIG,
        "open_work_board": {"google_docs_url": _OPEN_WORK_URL},
    }
    monkeypatch.setattr(data_module, "workflow_registry", registry)

    class _StubDocs:
        async def execute(self, action: str, params: dict) -> dict:
            return {
                "opportunities": [
                    {"title": "Internal Training", "type": "internal", "details": "Internal Training"},
                    {"title": "Project Alpha", "type": "billable", "details": "Project Alpha"},
                    {"title": "Project Beta", "type": "billable", "details": "Project Beta"},
                    {"title": "Admin Work", "type": "internal", "details": "Admin Work"},
                ]
            }

    monkeypatch.setattr(data_module, "_google_docs", _StubDocs())

    response = await client.get("/api/data/open-work", headers=SESSION_HEADERS)
    assert response.status_code == 200
    body = response.json()
    items = body["data"]
    assert len(items) == 4

    # Verify billable items come before internal items
    types = [item["type"] for item in items]
    last_billable = max((i for i, t in enumerate(types) if t == "billable"), default=-1)
    first_internal = min((i for i, t in enumerate(types) if t == "internal"), default=len(types))
    assert last_billable < first_internal


