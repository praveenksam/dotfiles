import asyncio
import logging
import re
import time

import httpx

from app.core.config import settings
from app.core.exceptions import IntegrationError
from app.integrations.base import IntegrationBase, IntegrationStatus

logger = logging.getLogger(__name__)

_TOKEN_ENDPOINT = "https://oauth2.googleapis.com/token"
_DOCS_API_BASE = "https://docs.googleapis.com/v1/documents"
_TOKEN_EXPIRY_BUFFER_SECS = 60

# Section opener patterns; only honored when the paragraph is a heading style.
_BILLABLE_HEADER_RE = re.compile(r"^(billable|client\s+work)\s*$", re.IGNORECASE)
_INTERNAL_HEADER_RE = re.compile(r"^(internal|internal\s+work)\s*$", re.IGNORECASE)
_HEADING_STYLES = (
    "TITLE",
    "SUBTITLE",
    "HEADING_1",
    "HEADING_2",
    "HEADING_3",
    "HEADING_4",
    "HEADING_5",
    "HEADING_6",
)

_DOC_ID_RE = re.compile(r"/document/d/([a-zA-Z0-9_-]+)")


def _extract_doc_id(url: str) -> str:
    m = _DOC_ID_RE.search(url)
    if not m:
        raise IntegrationError("google_docs", f"Cannot extract document ID from URL: {url}")
    return m.group(1)


def _paragraph_text(paragraph: dict) -> str:
    return "".join(
        el.get("textRun", {}).get("content", "")
        for el in paragraph.get("elements", [])
    ).strip()


def _extract_lines(document: dict) -> list[str]:
    """Flat text projection of a Google Docs body — used by fetch_tasks."""
    lines: list[str] = []
    for block in document.get("body", {}).get("content", []):
        paragraph = block.get("paragraph")
        if not paragraph:
            continue
        text = _paragraph_text(paragraph)
        if text:
            lines.append(text)
    return lines


def _iter_paragraphs(document: dict):
    """Yield (text, style, is_bullet) for each non-empty paragraph block.

    Non-paragraph blocks (tables, sectionBreaks, tableOfContents) are skipped.
    """
    for block in document.get("body", {}).get("content", []):
        paragraph = block.get("paragraph")
        if not paragraph:
            continue
        text = _paragraph_text(paragraph)
        if not text:
            continue
        style = paragraph.get("paragraphStyle", {}).get("namedStyleType", "NORMAL_TEXT")
        is_bullet = "bullet" in paragraph
        yield text, style, is_bullet


def _parse_open_work(document: dict) -> list[dict]:
    """Parse open-work opportunities using paragraph style metadata.

    A heading-style paragraph whose text matches the billable / internal pattern
    advances the current section. Other headings are ignored. Within a section,
    a non-bullet paragraph starts a new opportunity (text becomes the title);
    bullet paragraphs append to the most recent opportunity's details (joined
    by newlines). Default section before any matching header: "internal".
    """
    current_type = "internal"
    opportunities: list[dict] = []
    last: dict | None = None

    for text, style, is_bullet in _iter_paragraphs(document):
        if style in _HEADING_STYLES:
            if _BILLABLE_HEADER_RE.match(text):
                current_type = "billable"
                last = None
            elif _INTERNAL_HEADER_RE.match(text):
                current_type = "internal"
                last = None
            continue
        if is_bullet and last is not None:
            last["details"] = f"{last['details']}\n{text}" if last["details"] else text
            continue
        last = {"title": text, "type": current_type, "details": ""}
        opportunities.append(last)

    return opportunities


class GoogleDocsIntegration(IntegrationBase):
    def __init__(self) -> None:
        self._access_token: str | None = None
        self._token_expiry: float = 0.0
        self._token_lock = asyncio.Lock()

    @property
    def name(self) -> str:
        return "google_docs"

    def _credentials_present(self) -> bool:
        return bool(
            settings.GOOGLE_DOCS_CLIENT_ID
            and settings.GOOGLE_DOCS_CLIENT_SECRET
            and settings.GOOGLE_DOCS_REFRESH_TOKEN
        )

    def _missing_credential(self) -> str:
        if not settings.GOOGLE_DOCS_CLIENT_ID:
            return "GOOGLE_DOCS_CLIENT_ID"
        if not settings.GOOGLE_DOCS_CLIENT_SECRET:
            return "GOOGLE_DOCS_CLIENT_SECRET"
        return "GOOGLE_DOCS_REFRESH_TOKEN"

    async def _get_access_token(self) -> str:
        if self._access_token and time.monotonic() < self._token_expiry:
            return self._access_token

        async with self._token_lock:
            if self._access_token and time.monotonic() < self._token_expiry:
                return self._access_token

            try:
                async with httpx.AsyncClient(timeout=10.0) as client:
                    response = await client.post(
                        _TOKEN_ENDPOINT,
                        data={
                            "grant_type": "refresh_token",
                            "client_id": settings.GOOGLE_DOCS_CLIENT_ID,
                            "client_secret": settings.GOOGLE_DOCS_CLIENT_SECRET,
                            "refresh_token": settings.GOOGLE_DOCS_REFRESH_TOKEN,
                        },
                    )
            except httpx.HTTPError as exc:
                raise IntegrationError(
                    self.name, f"Google OAuth token request failed: {exc}"
                ) from exc

            if response.status_code != 200:
                raise IntegrationError(
                    self.name,
                    f"Google OAuth token refresh failed: HTTP {response.status_code}",
                )
            try:
                data = response.json()
            except ValueError as exc:
                raise IntegrationError(
                    self.name,
                    f"Google OAuth token endpoint returned invalid JSON: {exc}",
                ) from exc

            access_token = data.get("access_token")
            if not access_token:
                raise IntegrationError(
                    self.name,
                    "Google OAuth token response missing 'access_token'",
                )

            expires_in = int(data.get("expires_in", 3600))
            self._access_token = access_token
            self._token_expiry = time.monotonic() + max(0, expires_in - _TOKEN_EXPIRY_BUFFER_SECS)
            return self._access_token

    async def _fetch_document(self, doc_id: str, token: str) -> dict:
        url = f"{_DOCS_API_BASE}/{doc_id}"
        try:
            async with httpx.AsyncClient(timeout=10.0) as client:
                response = await client.get(url, headers={"Authorization": f"Bearer {token}"})
        except httpx.HTTPError as exc:
            raise IntegrationError(
                self.name, f"Google Docs request failed: {exc}"
            ) from exc
        if response.status_code != 200:
            raise IntegrationError(
                self.name,
                f"Google Docs API returned HTTP {response.status_code} for document {doc_id}",
            )
        try:
            return response.json()
        except ValueError as exc:
            raise IntegrationError(
                self.name,
                f"Google Docs API returned invalid JSON: {exc}",
            ) from exc

    async def health_check(self) -> IntegrationStatus:
        if not self._credentials_present():
            return IntegrationStatus(
                name=self.name,
                status="unavailable",
                error=f"{self._missing_credential()} not set",
            )
        try:
            start = time.monotonic()
            await self._get_access_token()
            latency_ms = int((time.monotonic() - start) * 1000)
            return IntegrationStatus(name=self.name, status="healthy", latency_ms=latency_ms)
        except Exception as exc:
            return IntegrationStatus(name=self.name, status="unavailable", error=str(exc))

    async def execute(self, action: str, params: dict) -> dict:
        if not self._credentials_present():
            raise IntegrationError(self.name, "Google Docs credentials not configured")

        if action == "fetch_tasks":
            return await self._fetch_tasks(params)
        elif action == "fetch_open_work":
            return await self._fetch_open_work(params)
        else:
            raise IntegrationError(self.name, f"Unknown action: {action}")

    async def _fetch_tasks(self, params: dict) -> dict:
        url = params.get("url", "")
        doc_id = _extract_doc_id(url)
        token = await self._get_access_token()
        document = await self._fetch_document(doc_id, token)
        tasks = _extract_lines(document)
        return {"tasks": tasks}

    async def _fetch_open_work(self, params: dict) -> dict:
        url = params.get("url", "")
        doc_id = _extract_doc_id(url)
        token = await self._get_access_token()
        document = await self._fetch_document(doc_id, token)
        opportunities = _parse_open_work(document)
        return {"opportunities": opportunities}
