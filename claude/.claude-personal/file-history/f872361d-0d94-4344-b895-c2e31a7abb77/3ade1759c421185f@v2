  .link { stroke: #2d4a6e; stroke-width: 1.5; fill: none; marker-end: url(#arrow); opacity: 0.6; }
  .link.highlighted { stroke: #7c3aed; stroke-width: 2.5; opacity: 1; }
  .link.dimmed { opacity: 0.08; }

