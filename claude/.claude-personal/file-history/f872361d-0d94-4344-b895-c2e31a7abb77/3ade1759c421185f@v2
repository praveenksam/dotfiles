  { source: 'app/api/data.py', target: 'app/schemas/status.py',            symbols: ['Meta'] },

  // API chat (ORCHESTRATION HUB)
  { source: 'app/api/chat.py', target: 'app/agent/capacity.py',           symbols: ['check_capacity()'] },
  { source: 'app/api/chat.py', target: 'app/agent/masking.py',            symbols: ['TokenMap', 'mask_fields()', 'mask_text()', 'rehydrate_text()'] },
  { source: 'app/api/chat.py', target: 'app/agent/provider_factory.py',   symbols: ['get_provider()'] },
  { source: 'app/api/chat.py', target: 'app/config/workflow_registry.py', symbols: ['workflow_registry'] },
  { source: 'app/api/chat.py', target: 'app/core/exceptions.py',          symbols: ['IntegrationError', 'ProviderError'] },
  { source: 'app/api/chat.py', target: 'app/db/deps.py',                  symbols: ['get_db'] },
  { source: 'app/api/chat.py', target: 'app/integrations/__init__.py',    symbols: ['ALL_INTEGRATIONS'] },
  { source: 'app/api/chat.py', target: 'app/models/interaction_log.py',   symbols: ['InteractionLog'] },
  { source: 'app/api/chat.py', target: 'app/schemas/chat.py',             symbols: ['ChatData', 'ChatRequest', 'ChatResponse', 'ConfirmPayload', 'ToolCallProposal'] },
  { source: 'app/api/chat.py', target: 'app/schemas/status.py',           symbols: ['Meta'] },

  // API integrations
  { source: 'app/api/integrations.py', target: 'app/agent/provider_factory.py',   symbols: ['get_provider()'] },
  { source: 'app/api/integrations.py', target: 'app/api/deps.py',                 symbols: ['require_admin'] },
  { source: 'app/api/integrations.py', target: 'app/core/exceptions.py',          symbols: ['IntegrationError', 'ProviderError'] },
  { source: 'app/api/integrations.py', target: 'app/db/deps.py',                  symbols: ['get_db'] },
  { source: 'app/api/integrations.py', target: 'app/integrations/__init__.py',    symbols: ['ALL_INTEGRATIONS'] },
  { source: 'app/api/integrations.py', target: 'app/schemas/status.py',           symbols: ['IntegrationStatusItem', 'IntegrationTestResponse', 'Meta'] },

  // API admin/config
  { source: 'app/api/admin/config.py', target: 'app/api/deps.py',                  symbols: ['require_admin'] },
  { source: 'app/api/admin/config.py', target: 'app/config/workflow_registry.py',  symbols: ['workflow_registry'] },
  { source: 'app/api/admin/config.py', target: 'app/db/deps.py',                   symbols: ['get_db'] },
  { source: 'app/api/admin/config.py', target: 'app/schemas/config.py',            symbols: ['WorkflowConfigUploadResponse'] },
  { source: 'app/api/admin/config.py', target: 'app/schemas/status.py',            symbols: ['Meta'] },

  // API admin/credentials
  { source: 'app/api/admin/credentials.py', target: 'app/api/deps.py',                symbols: ['require_admin'] },
  { source: 'app/api/admin/credentials.py', target: 'app/db/deps.py',                 symbols: ['get_db'] },
  { source: 'app/api/admin/credentials.py', target: 'app/models/credential_store.py', symbols: ['CredentialStore'] },
  { source: 'app/api/admin/credentials.py', target: 'app/schemas/credentials.py',     symbols: ['CredentialGetResponse', 'CredentialUpsertRequest', 'CredentialUpsertResponse'] },
  { source: 'app/api/admin/credentials.py', target: 'app/schemas/status.py',          symbols: ['Meta'] },
  { source: 'app/api/admin/credentials.py', target: 'app/services/encryption.py',     symbols: ['encrypt()'] },

  // API admin/logs
  { source: 'app/api/admin/logs.py', target: 'app/api/deps.py',                symbols: ['require_admin'] },
  { source: 'app/api/admin/logs.py', target: 'app/db/deps.py',                  symbols: ['get_db'] },
  { source: 'app/api/admin/logs.py', target: 'app/models/interaction_log.py',   symbols: ['InteractionLog'] },
  { source: 'app/api/admin/logs.py', target: 'app/models/session.py',           symbols: ['Session'] },
  { source: 'app/api/admin/logs.py', target: 'app/schemas/logs.py',             symbols: ['LogEntry', 'LogsResponse', 'SessionLookupData', 'SessionLookupResponse'] },
  { source: 'app/api/admin/logs.py', target: 'app/schemas/status.py',           symbols: ['Meta'] },
];

// ─── LEGEND ──────────────────────────────────────────────────────────────────
const legendEl = document.getElementById('legend-items');
Object.entries(GROUPS).forEach(([key, val]) => {
  const row = document.createElement('div');
  row.className = 'legend-item';
  row.innerHTML = `<div class="legend-dot" style="background:${val.color}"></div><span>${val.label}</span>`;
  legendEl.appendChild(row);
});

// ─── GRAPH SETUP ─────────────────────────────────────────────────────────────
const svg = d3.select('#graph');
const container = document.getElementById('graph-container');
const W = () => container.clientWidth;
const H = () => container.clientHeight;

const g = svg.append('g');

// Arrow marker
svg.append('defs').append('marker')
  .attr('id', 'arrow')
  .attr('viewBox', '0 -4 8 8')
  .attr('refX', 18).attr('refY', 0)
  .attr('markerWidth', 6).attr('markerHeight', 6)
  .attr('orient', 'auto')
  .append('path')
  .attr('d', 'M0,-4L8,0L0,4')
  .attr('fill', '#2d4a6e');

svg.append('defs').append('marker')
  .attr('id', 'arrow-highlight')
  .attr('viewBox', '0 -4 8 8')
  .attr('refX', 18).attr('refY', 0)
  .attr('markerWidth', 6).attr('markerHeight', 6)
  .attr('orient', 'auto')
  .append('path')
  .attr('d', 'M0,-4L8,0L0,4')
  .attr('fill', '#7c3aed');

// Zoom
const zoom = d3.zoom().scaleExtent([0.1, 4]).on('zoom', e => g.attr('transform', e.transform));
svg.call(zoom);

let showLabels = true;

// Build adjacency for highlight
const adjOut = {}, adjIn = {};
nodes.forEach(n => { adjOut[n.id] = []; adjIn[n.id] = []; });
links.forEach(l => {
  adjOut[l.source] && adjOut[l.source].push(l.target);
  adjIn[l.target] && adjIn[l.target].push(l.source);
});

// ─── SIMULATION ──────────────────────────────────────────────────────────────
const simulation = d3.forceSimulation(nodes)
  .force('link', d3.forceLink(links).id(d => d.id).distance(d => {
    const sg = d.source.group, tg = d.target.group;
    if (sg === tg) return 80;
    if (sg === 'api' || tg === 'api') return 130;
    return 110;
  }).strength(0.4))
  .force('charge', d3.forceManyBody().strength(-320))
  .force('center', d3.forceCenter(W() / 2, H() / 2))
  .force('collision', d3.forceCollide(30));

// ─── LINKS ───────────────────────────────────────────────────────────────────
const linkEl = g.append('g').selectAll('path')
  .data(links).join('path')
  .attr('class', 'link')
  .attr('id', (d, i) => `link-${i}`);

const edgeLabelEl = g.append('g').selectAll('text')
  .data(links).join('text')
  .attr('class', 'edge-label')
  .text(d => d.symbols.slice(0, 2).join(', ') + (d.symbols.length > 2 ? ' …' : ''));

// ─── NODES ───────────────────────────────────────────────────────────────────
const nodeEl = g.append('g').selectAll('g')
  .data(nodes).join('g')
  .attr('class', 'node')
  .call(d3.drag()
    .on('start', (e, d) => { if (!e.active) simulation.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; })
    .on('drag',  (e, d) => { d.fx = e.x; d.fy = e.y; })
    .on('end',   (e, d) => { if (!e.active) simulation.alphaTarget(0); d.fx = null; d.fy = null; })
  )
  .on('click', (e, d) => { e.stopPropagation(); selectNode(d); });

nodeEl.append('circle')
  .attr('r', d => {
    if (d.group === 'entry') return 14;
    if (d.group === 'api')   return 12;
    return 9;
  })
  .attr('fill', d => GROUPS[d.group].color + '33')
  .attr('stroke', d => GROUPS[d.group].color);

nodeEl.append('text')
  .attr('dy', d => (d.group === 'entry' ? -18 : -14))
  .attr('text-anchor', 'middle')
  .text(d => d.label);

// Deselect on background click
svg.on('click', () => selectNode(null));

// ─── SIMULATION TICK ─────────────────────────────────────────────────────────
function linkArc(d) {
  const sx = d.source.x, sy = d.source.y, tx = d.target.x, ty = d.target.y;
  const dx = tx - sx, dy = ty - sy;
  const dr = Math.sqrt(dx*dx + dy*dy) * 2;
  return `M${sx},${sy}A${dr},${dr} 0 0,1 ${tx},${ty}`;
}

simulation.on('tick', () => {
  linkEl.attr('d', linkArc);
  edgeLabelEl
    .attr('x', d => (d.source.x + d.target.x) / 2)
    .attr('y', d => (d.source.y + d.target.y) / 2);
  nodeEl.attr('transform', d => `translate(${d.x},${d.y})`);
});

// ─── SELECTION ───────────────────────────────────────────────────────────────
let selectedId = null;

function selectNode(d) {
  selectedId = d ? d.id : null;

  if (!selectedId) {
    nodeEl.classed('selected', false).classed('dimmed', false);
    linkEl.classed('highlighted', false).classed('dimmed', false).attr('marker-end', 'url(#arrow)');
    edgeLabelEl.classed('show', false);
    renderDetail(null);
    return;
  }

  const connected = new Set([selectedId, ...(adjOut[selectedId]||[]), ...(adjIn[selectedId]||[])]);
  nodeEl.classed('selected', n => n.id === selectedId).classed('dimmed', n => !connected.has(n.id));
  linkEl
    .classed('highlighted', l => l.source.id === selectedId || l.target.id === selectedId)
    .classed('dimmed', l => l.source.id !== selectedId && l.target.id !== selectedId)
    .attr('marker-end', l => (l.source.id === selectedId || l.target.id === selectedId)
      ? 'url(#arrow-highlight)' : 'url(#arrow)');
  edgeLabelEl.classed('show', l => l.source.id === selectedId || l.target.id === selectedId);
  renderDetail(d);
}

function renderDetail(d) {
  const el = document.getElementById('detail-content');
  if (!d) { el.innerHTML = '<p class="no-select">Select a node to see details</p>'; return; }

  const outLinks = links.filter(l => l.source.id === d.id || (typeof l.source === 'object' && l.source.id === d.id));
  const inLinks  = links.filter(l => l.target.id === d.id || (typeof l.target === 'object' && l.target.id === d.id));

  let html = `
    <div class="detail-path">${d.id}</div>
    <div style="font-size:11px;color:#e2e8f0;margin-bottom:12px;line-height:1.5">${d.description}</div>
  `;

  if (d.functions.length) {
    html += `<div class="detail-section">
      <div class="detail-section-title">Defines / Exports</div>
      <div>${d.functions.map(f => `<span class="fn-tag">${f}</span>`).join('')}</div>
    </div>`;
  }

  if (outLinks.length) {
    html += `<div class="detail-section">
      <div class="detail-section-title">Imports From (→)</div>`;
    outLinks.forEach(l => {
      const tid = typeof l.target === 'object' ? l.target.id : l.target;
      html += `<div class="dep-row">
        <div class="dep-file"><span>${tid}</span></div>
        ${l.symbols.length ? `<div class="sym-list">${l.symbols.map(s=>`<b>${s}</b>`).join(', ')}</div>` : ''}
      </div>`;
    });
    html += '</div>';
  }

  if (inLinks.length) {
    html += `<div class="detail-section">
      <div class="detail-section-title">Imported By (←)</div>`;
    inLinks.forEach(l => {
      const sid = typeof l.source === 'object' ? l.source.id : l.source;
      html += `<div class="dep-row">
        <div class="dep-file"><span>${sid}</span></div>
        ${l.symbols.length ? `<div class="sym-list">${l.symbols.map(s=>`<b>${s}</b>`).join(', ')}</div>` : ''}
      </div>`;
    });
    html += '</div>';
  }

  el.innerHTML = html;
}

// ─── SEARCH ──────────────────────────────────────────────────────────────────
document.getElementById('search-box').addEventListener('input', function() {
  const q = this.value.toLowerCase();
  if (!q) { nodeEl.classed('dimmed', false); return; }
  nodeEl.classed('dimmed', d => !d.label.toLowerCase().includes(q) && !d.id.toLowerCase().includes(q));
});

// ─── CONTROLS ────────────────────────────────────────────────────────────────
document.getElementById('btn-zoom-in').addEventListener('click', () =>
  svg.transition().call(zoom.scaleBy, 1.4));
document.getElementById('btn-zoom-out').addEventListener('click', () =>
  svg.transition().call(zoom.scaleBy, 0.7));
document.getElementById('btn-reset').addEventListener('click', () =>
  svg.transition().call(zoom.transform, d3.zoomIdentity.translate(W()/2, H()/2).scale(0.8)));
document.getElementById('btn-expand').addEventListener('click', () => {
  showLabels = !showLabels;
  nodeEl.selectAll('text').attr('display', showLabels ? null : 'none');
});

// Initial zoom
svg.call(zoom.transform, d3.zoomIdentity.translate(W()/2, H()/2).scale(0.75));
</script>
</body>
</html>
