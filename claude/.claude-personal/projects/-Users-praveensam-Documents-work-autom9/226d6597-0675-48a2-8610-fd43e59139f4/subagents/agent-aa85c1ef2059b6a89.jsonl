ware,\n45\t    allow_origins=[o.strip() for o in settings.CORS_ORIGINS.split(\",\") if o.strip()],\n46\t    allow_credentials=True,\n47\t    allow_methods=[\"*\"],\n48\t    allow_headers=[\"*\"],\n49\t)\n50\t"}]},"uuid":"f8538a2f-dd28-4924-9195-01140db3e767","timestamp":"2026-04-29T14:26:19.846Z","sourceToolAssistantUUID":"a6c30bf2-d5d5-4856-a812-c0bc136f5642","userType":"external","entrypoint":"cli","cwd":"/Users/praveensam/Documents/work/autom9/autom9-backend","sessionId":"226d6597-0675-48a2-8610-fd43e59139f4","version":"2.1.116","gitBranch":"main"}
