<script lang="ts">
  import { onMount } from 'svelte';
  import { apiFetch, ApiError } from '../lib/api';
  import { getWorksheetData } from '../lib/tableau';
  import { sessionStore } from '../stores/session.svelte';
  import { dataStore, extractAvailableDays, extractAvailableRows } from '../stores/data.svelte';

  const sessionHeaders = (): Record<string, string> =>
    sessionStore.sessionId ? { 'X-Autom9-Session': sessionStore.sessionId } : {};

  type WorksheetConfig = {
    worksheetName: string | null;
    availableDaysColumn: string | null;
    availabilityColumn: string | null;
    availabilityValue: string | null;
  };

  // Returns worksheet config from /api/config/workflow, or nulls if not set.
  // Throws ApiError/Error if the config endpoint is unreachable.
  async function loadWorksheetConfig(): Promise<WorksheetConfig> {
    const config = await apiFetch<{
      data: {
        data_panel?: {
          worksheet_name?: string;
          available_days_column?: string;
          availability_column?: string;
          availability_value?: string;
        };
      } | null;
    }>('/api/config/workflow');
    return {
      worksheetName: config.data?.data_panel?.worksheet_name ?? null,
      availableDaysColumn: config.data?.data_panel?.available_days_column ?? null,
      availabilityColumn: config.data?.data_panel?.availability_column ?? null,
      availabilityValue: config.data?.data_panel?.availability_value ?? null,
    };
  }

  let availabilityColumn = $state<string | null>(null);
  let availabilityValue = $state<string | null>(null);
  let availableRowSet = $derived(new Set(
    extractAvailableRows(dataStore.worksheetRows, availabilityColumn, availabilityValue)
  ));

  function isAvailableRow(row: import('../lib/tableau').WorksheetRow): boolean {
    return availableRowSet.has(row);
  }

  function toggleRow(row: import('../lib/tableau').WorksheetRow, checked: boolean): void {
    if (checked) {
      if (!dataStore.selectedRows.includes(row)) {
        dataStore.selectedRows = [...dataStore.selectedRows, row];
      }
    } else {
      dataStore.selectedRows = dataStore.selectedRows.filter((r) => r !== row);
    }
  }

  async function loadWorksheetData(
    worksheetName: string,
    config: WorksheetConfig
  ): Promise<void> {
    dataStore.worksheetState = 'loading';
    try {
      dataStore.worksheetRows = await getWorksheetData(worksheetName);
      dataStore.availableDays = extractAvailableDays(dataStore.worksheetRows, config.availableDaysColumn);
      availabilityColumn = config.availabilityColumn;
      availabilityValue = config.availabilityValue;
      dataStore.selectedRows = [];
      dataStore.worksheetState = 'done';
    } catch {
      // Generic message — never expose raw error details to the consultant (AC4)
      dataStore.availableDays = null;
      dataStore.worksheetError = 'Could not load worksheet data';
      dataStore.worksheetState = 'error';
    }
  }

  async function loadTasks(): Promise<void> {
    dataStore.tasksState = 'loading';
    try {
      const response = await apiFetch<{ data: Array<{ text: string }> }>('/api/data/tasks', {
        headers: sessionHeaders(),
      });
      dataStore.tasks = response.data;
      dataStore.tasksState = 'done';
    } catch (err) {
      const msg =
        err instanceof ApiError
          ? err.message
          : err instanceof Error
            ? err.message
            : 'Could not load task list';
      dataStore.tasksError = msg;
      dataStore.tasksState = 'error';
    }
  }

  onMount(() => {
    let active = true; // abort guard — prevents stale promise writes on rapid remount

    (async () => {
      // Distinguish config fetch failure from worksheet simply not being configured
      let worksheetConfig: WorksheetConfig | null = null;
      let configFetchError: string | null = null;
      try {
        worksheetConfig = await loadWorksheetConfig();
      } catch (err) {
        configFetchError =
          err instanceof ApiError ? err.message : 'Could not load configuration';
      }

      if (!active) return;

      const worksheetName = worksheetConfig?.worksheetName ?? null;

      // Both fetches run independently — one failure must not block the other (NFR9)
      const worksheetPromise = worksheetName && worksheetConfig
        ? loadWorksheetData(worksheetName, worksheetConfig)
        : (() => {
            dataStore.worksheetError = configFetchError ?? 'Worksheet name not configured';
            dataStore.worksheetState = 'error';
            return Promise.resolve();
          })();

      await Promise.allSettled([worksheetPromise, loadTasks()]);
    })();

    return () => {
      active = false; // cancel on unmount
    };
  });
</script>

<div class="data-panel">
  <!-- Open days / scheduled engagements from Tableau worksheet -->
  <section class="panel-section">
    <h3>Open Days &amp; Engagements</h3>
    {#if dataStore.worksheetState === 'loading'}
      <p class="loading">Loading…</p>
    {:else if dataStore.worksheetState === 'error'}
      <p class="error">{dataStore.worksheetError}</p>
    {:else if dataStore.worksheetRows.length === 0}
      <p class="empty">No data available</p>
    {:else}
      <table>
        <thead>
          <tr>
            {#if availabilityColumn && availabilityValue}
              <th class="col-select"></th>
            {/if}
            {#each Object.keys(dataStore.worksheetRows[0]) as col}
              <th>{col}</th>
            {/each}
          </tr>
        </thead>
        <tbody>
          {#each dataStore.worksheetRows as row}
            {@const selectable = isAvailableRow(row)}
            <tr class={selectable ? 'row-available' : ''}>
              {#if availabilityColumn && availabilityValue}
                <td class="col-select">
                  {#if selectable}
                    <input
                      type="checkbox"
                      checked={dataStore.selectedRows.includes(row)}
                      onchange={(e) => toggleRow(row, (e.target as HTMLInputElement).checked)}
                    />
                  {/if}
                </td>
              {/if}
              {#each Object.values(row) as val}
                <td>{val}</td>
              {/each}
            </tr>
          {/each}
        </tbody>
      </table>
    {/if}
  </section>

  <!-- Task list from Google Docs -->
  <section class="panel-section">
    <h3>Task List</h3>
    {#if dataStore.tasksState === 'loading'}
      <p class="loading">Loading…</p>
    {:else if dataStore.tasksState === 'error'}
      <p class="error">{dataStore.tasksError}</p>
    {:else if dataStore.tasks.length === 0}
      <p class="empty">No tasks available</p>
    {:else}
      <ul>
        {#each dataStore.tasks as task}
          <li>{task.text}</li>
        {/each}
      </ul>
    {/if}
  </section>
</div>

