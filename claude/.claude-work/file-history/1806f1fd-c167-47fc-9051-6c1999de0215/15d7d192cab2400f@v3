async def test_check_capacity_via_context_selection(client: AsyncClient, monkeypatch):
    """context_selection with 3 rows → effective_available_days=3 → capacity result returned."""
    import app.api.chat as chat_module
    from app.config.workflow_registry import WorkflowRegistry

    registry = WorkflowRegistry()
    registry._active = _CONFIG_WITH_CAPACITY_TOOL
    monkeypatch.setattr(chat_module, "workflow_registry", registry)

    captured_tool_result: dict = {}
    captured_first_messages: list = []

    async def _side_effect(messages, tools):
        for msg in messages:
            if "[Tool result for check_capacity]" in msg.get("content", ""):
                captured_tool_result.update(json.loads(msg["content"].split("]: ", 1)[1]))
        if not captured_tool_result:
            captured_first_messages.extend(messages)
            return LLMResponse(
                content="",
                tool_calls=[{"id": "1", "name": "check_capacity", "arguments": {"required_days": 2}}],
                finish_reason="tool_calls",
            )
        return LLMResponse(content="Capacity confirmed.", tool_calls=[], finish_reason="stop")

    mock_provider = AsyncMock()
    mock_provider.complete.side_effect = _side_effect
    monkeypatch.setattr(chat_module, "get_provider", AsyncMock(return_value=mock_provider))

    selected_rows = [
        {"Date": "2026-05-05", "Status": "Available"},
        {"Date": "2026-05-06", "Status": "Available"},
        {"Date": "2026-05-07", "Status": "Available"},
    ]

    response = await client.post(
        "/api/chat",
        json={"message": "Can I take the project?", "context_selection": selected_rows},
        headers=SESSION_HEADERS,
    )
    assert response.status_code == 200
    assert response.json()["data"]["reply"] == "Capacity confirmed."
    # effective_available_days = len(selected_rows) = 3; required_days=2 → can_commit=True
    assert captured_tool_result["can_commit"] is True
    assert captured_tool_result["available_days"] == 3.0
    # [Selected context] message injected before consultant's user turn
    context_msg = next(
        (m for m in captured_first_messages if "[Selected context]" in m.get("content", "")),
        None,
    )
    assert context_msg is not None
    assert "2026-05-05" in context_msg["content"]


