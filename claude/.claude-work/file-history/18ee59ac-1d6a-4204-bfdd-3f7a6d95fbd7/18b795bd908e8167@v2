"""
One-time script to get a Google OAuth refresh token for Calendar + Docs.
Usage: uv run python get_google_token.py
"""
import http.server
import json
import secrets
import threading
import urllib.parse
import urllib.request
import webbrowser

CLIENT_ID = input("Client ID: ").strip()
CLIENT_SECRET = input("Client Secret: ").strip()

SCOPES = [
    "https://www.googleapis.com/auth/calendar",
    "https://www.googleapis.com/auth/documents.readonly",
]
REDIRECT_URI = "http://localhost:8765"
STATE = secrets.token_urlsafe(16)

auth_code: list[str] = []
server_done = threading.Event()


class _Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)
        code = params.get("code", [None])[0]
        state = params.get("state", [None])[0]
        if code and state == STATE:
            auth_code.append(code)
            body = b"<h2>Authorized. You can close this tab.</h2>"
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(body)
        else:
            self.send_response(400)
            self.end_headers()
        server_done.set()

    def log_message(self, *_):
        pass


server = http.server.HTTPServer(("localhost", 8765), _Handler)
thread = threading.Thread(target=lambda: server.handle_request())
thread.start()

params = urllib.parse.urlencode({
    "client_id": CLIENT_ID,
    "redirect_uri": REDIRECT_URI,
    "response_type": "code",
    "scope": " ".join(SCOPES),
    "access_type": "offline",
    "prompt": "consent",
    "state": STATE,
})
url = f"https://accounts.google.com/o/oauth2/v2/auth?{params}"
print(f"\nOpening browser. If it doesn't open, visit:\n{url}\n")
webbrowser.open(url)

server_done.wait(timeout=120)
thread.join()

if not auth_code:
    print("ERROR: No auth code received within 120s.")
    raise SystemExit(1)

data = urllib.parse.urlencode({
    "code": auth_code[0],
    "client_id": CLIENT_ID,
    "client_secret": CLIENT_SECRET,
    "redirect_uri": REDIRECT_URI,
    "grant_type": "authorization_code",
}).encode()

req = urllib.request.Request(
    "https://oauth2.googleapis.com/token",
    data=data,
    headers={"Content-Type": "application/x-www-form-urlencoded"},
)
with urllib.request.urlopen(req) as resp:
    tokens = json.loads(resp.read())

refresh_token = tokens.get("refresh_token")
if not refresh_token:
    print("ERROR: No refresh_token in response.")
    raise SystemExit(1)

print("\n=== Add these to autom9-backend/.env ===\n")
print(f"GOOGLE_CALENDAR_CLIENT_ID={CLIENT_ID}")
print(f"GOOGLE_CALENDAR_CLIENT_SECRET={CLIENT_SECRET}")
print(f"GOOGLE_CALENDAR_REFRESH_TOKEN={refresh_token}")
print(f"GOOGLE_DOCS_CLIENT_ID={CLIENT_ID}")
print(f"GOOGLE_DOCS_CLIENT_SECRET={CLIENT_SECRET}")
print(f"GOOGLE_DOCS_REFRESH_TOKEN={refresh_token}")
print()
