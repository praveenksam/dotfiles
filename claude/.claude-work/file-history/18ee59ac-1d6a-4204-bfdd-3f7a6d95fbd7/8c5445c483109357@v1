<script lang="ts">
  import { onMount } from 'svelte';
  import { apiFetch } from '../lib/api';
  import WorkflowConfigPanel from './WorkflowConfigPanel.svelte';

  let provider = $state<'openai' | 'anthropic'>('openai');
  let apiKey = $state('');
  let saving = $state(false);
  let saved = $state(false);
  let errorMsg = $state('');
  let existingMasked = $state<string | null>(null);

  onMount(async () => {
    try {
      const res = await apiFetch<{ data: { provider: string; masked_key: string } }>(
        `/api/admin/credentials/${provider}`,
      );
      existingMasked = res.data.masked_key;
    } catch {
      // 404 = no credentials stored yet — show empty form
      existingMasked = null;
    }
  });

  async function handleSubmit(e: SubmitEvent) {
    e.preventDefault();
    saving = true;
    saved = false;
    errorMsg = '';
    try {
      await apiFetch('/api/admin/credentials', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ provider, api_key: apiKey }),
      });
      saved = true;
      apiKey = '';
      existingMasked = '••••••••';
    } catch (err) {
      errorMsg = err instanceof Error ? err.message : 'Failed to save credentials';
    } finally {
      saving = false;
    }
  }
</script>

<form onsubmit={handleSubmit} class="admin-config">
  <h2>BYOM Credential Setup</h2>

  <label>
    LLM Provider
    <select bind:value={provider}>
      <option value="openai">OpenAI</option>
      <option value="anthropic">Anthropic</option>
    </select>
  </label>

  <label>
    API Key
    {#if existingMasked && !apiKey}
      <p class="existing-key">Current key: {existingMasked}</p>
    {/if}
    <input
      type="password"
      bind:value={apiKey}
      placeholder={existingMasked ? 'Enter new key to replace existing' : 'Paste API key here'}
      autocomplete="off"
      required
    />
  </label>

  {#if saved}
    <p class="success">Credentials saved.</p>
  {/if}
  {#if errorMsg}
    <p class="error">{errorMsg}</p>
  {/if}

  <button type="submit" disabled={saving}>
    {saving ? 'Saving…' : 'Save Credentials'}
  </button>
</form>

<WorkflowConfigPanel />

