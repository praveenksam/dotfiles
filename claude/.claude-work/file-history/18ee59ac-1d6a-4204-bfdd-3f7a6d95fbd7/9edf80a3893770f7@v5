{
  "version": "1.0.0",
  "workflow_id": "planning-v1",
  "agent_instructions": "You are a planning assistant for consultants. Help them manage their open days, review tasks, check capacity for open work opportunities, and submit planning requests. Always check capacity before recommending a consultant accept an open work opportunity. Never reveal internal token identifiers or raw data.",
  "data_panel": {
    "worksheet_name": "Consultant Availability",
    "google_docs_url": null,
    "availability_column": "Status",
    "availability_value": "Available"
  },
  "open_work_board": {
    "google_docs_url": "https://docs.google.com/document/d/YOUR_OPEN_WORK_DOC_ID/edit"
  },
  "tools": [
    {
      "name": "fetch_open_work",
      "description": "Fetch the current list of open work opportunities from the org-wide board. Call this when the consultant asks about available work, open opportunities, or what projects are available to pick up.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "integration": null,
      "action": "fetch_open_work"
    },
    {
      "name": "check_capacity",
      "description": "Calculate whether the consultant can commit to an open work opportunity given their available open days and the opportunity's required time commitment. Applies a 5% buffer. Use when a consultant asks if they can take on an opportunity.",
      "parameters": {
        "type": "object",
        "properties": {
          "required_days": {
            "type": "number",
            "description": "The number of days the opportunity requires. Extract this from the opportunity details in the conversation."
          }
        },
        "required": [
          "required_days"
        ]
      },
      "integration": null,
      "action": "check_capacity"
    },
    {
      "name": "submit_planning_request",
      "description": "Submit a planning request to Smartsheet on behalf of the consultant for their open days.",
      "parameters": {
        "type": "object",
        "properties": {
          "consultant_name": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "description": "ISO 8601 date"
          },
          "end_date": {
            "type": "string",
            "description": "ISO 8601 date"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "consultant_name",
          "start_date",
          "end_date"
        ]
      },
      "integration": "smartsheet",
      "action": "submit_planning_request"
    },
    {
      "name": "create_calendar_invite",
      "description": "Create a Google Calendar invite for a scheduled engagement.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "start_datetime": {
            "type": "string",
            "description": "ISO 8601 datetime"
          },
          "end_datetime": {
            "type": "string",
            "description": "ISO 8601 datetime"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "start_datetime",
          "end_datetime"
        ]
      },
      "integration": "google_calendar",
      "action": "create_invite"
    }
  ]
}
