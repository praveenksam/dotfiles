<script lang="ts">
  import { apiFetch } from '../lib/api';

  let configJson = $state('');
  let saving = $state(false);
  let saved = $state(false);
  let errorMsg = $state('');
  const placeholderText =
    '{"version": "1.0.0", "workflow_id": "...", "tools": [], "agent_instructions": "..."}';

  async function handleSubmit(e: SubmitEvent) {
    e.preventDefault();
    saving = true;
    saved = false;
    errorMsg = '';
    try {
      let parsed: unknown;
      try {
        parsed = JSON.parse(configJson);
      } catch {
        errorMsg = 'Invalid JSON — please check your config file.';
        return;
      }
      await apiFetch('/api/admin/config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(parsed),
      });
      saved = true;
    } catch (err) {
      errorMsg = err instanceof Error ? err.message : 'Failed to upload config';
    } finally {
      saving = false;
    }
  }
</script>

<section class="workflow-config-panel">
  <h3>Workflow Configuration</h3>
  <form onsubmit={handleSubmit}>
    <label>
      Config JSON
      <textarea
        bind:value={configJson}
        rows={10}
        placeholder={placeholderText}
        required
      ></textarea>
    </label>

    {#if saved}
      <p class="success">Workflow config uploaded successfully.</p>
    {/if}
    {#if errorMsg}
      <p class="error">{errorMsg}</p>
    {/if}

    <button type="submit" disabled={saving}>
      {saving ? 'Uploading…' : 'Upload Config'}
    </button>
  </form>
</section>

