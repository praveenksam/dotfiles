class ChatStore {
  messages = $state<ChatMessage[]>([]);
  chatState = $state<ChatState>('idle');
  chatError = $state<string | null>(null);
  pendingAction = $state<ToolCallProposal | null>(null);

  get history(): ChatMessage[] {
    return this.messages;
  }

  addUserMessage(content: string): void {
    this.messages = [...this.messages, { role: 'user', content }];
  }

  addAssistantMessage(content: string): void {
    this.messages = [...this.messages, { role: 'assistant', content }];
  }

  setError(msg: string): void {
    this.chatError = msg;
    this.chatState = 'error';
  }

  clearError(): void {
    this.chatError = null;
    if (this.chatState === 'error') this.chatState = 'idle';
  }

  setPendingAction(action: ToolCallProposal): void {
    this.pendingAction = action;
  }

  clearPendingAction(): void {
    this.pendingAction = null;
  }
}

export const chatStore = new ChatStore();
