<script lang="ts">
  import { onMount } from 'svelte';
  import { apiFetch, ApiError } from '../lib/api';
  import { getWorksheetData } from '../lib/tableau';
  import { sessionStore } from '../stores/session.svelte';
  import { dataStore } from '../stores/data.svelte';

  const sessionHeaders = (): Record<string, string> =>
    sessionStore.sessionId ? { 'X-Autom9-Session': sessionStore.sessionId } : {};

  // Returns worksheet name from config, or null if not set.
  // Throws ApiError/Error if the config endpoint is unreachable.
  async function loadWorksheetConfig(): Promise<string | null> {
    const config = await apiFetch<{ data: { data_panel?: { worksheet_name?: string } } | null }>(
      '/api/config/workflow'
    );
    return config.data?.data_panel?.worksheet_name ?? null;
  }

  async function loadWorksheetData(worksheetName: string): Promise<void> {
    dataStore.worksheetState = 'loading';
    try {
      dataStore.worksheetRows = await getWorksheetData(worksheetName);
      dataStore.worksheetState = 'done';
    } catch {
      // Generic message — never expose raw error details to the consultant (AC4)
      dataStore.worksheetError = 'Could not load worksheet data';
      dataStore.worksheetState = 'error';
    }
  }

  async function loadTasks(): Promise<void> {
    dataStore.tasksState = 'loading';
    try {
      const response = await apiFetch<{ data: Array<{ text: string }> }>('/api/data/tasks', {
        headers: sessionHeaders(),
      });
      dataStore.tasks = response.data;
      dataStore.tasksState = 'done';
    } catch (err) {
      const msg =
        err instanceof ApiError
          ? err.message
          : err instanceof Error
            ? err.message
            : 'Could not load task list';
      dataStore.tasksError = msg;
      dataStore.tasksState = 'error';
    }
  }

  onMount(() => {
    let active = true; // abort guard — prevents stale promise writes on rapid remount

    (async () => {
      // Distinguish config fetch failure from worksheet simply not being configured
      let worksheetName: string | null = null;
      let configFetchError: string | null = null;
      try {
        worksheetName = await loadWorksheetConfig();
      } catch (err) {
        configFetchError =
          err instanceof ApiError ? err.message : 'Could not load configuration';
      }

      if (!active) return;

      // Both fetches run independently — one failure must not block the other (NFR9)
      const worksheetPromise = worksheetName
        ? loadWorksheetData(worksheetName)
        : (() => {
            dataStore.worksheetError = configFetchError ?? 'Worksheet name not configured';
            dataStore.worksheetState = 'error';
            return Promise.resolve();
          })();

      await Promise.allSettled([worksheetPromise, loadTasks()]);
    })();

    return () => {
      active = false; // cancel on unmount
    };
  });
</script>

<div class="data-panel">
  <!-- Open days / scheduled engagements from Tableau worksheet -->
  <section class="panel-section">
    <h3>Open Days &amp; Engagements</h3>
    {#if dataStore.worksheetState === 'loading'}
      <p class="loading">Loading…</p>
    {:else if dataStore.worksheetState === 'error'}
      <p class="error">{dataStore.worksheetError}</p>
    {:else if dataStore.worksheetRows.length === 0}
      <p class="empty">No data available</p>
    {:else}
      <table>
        <thead>
          <tr>
            {#each Object.keys(dataStore.worksheetRows[0]) as col}
              <th>{col}</th>
            {/each}
          </tr>
        </thead>
        <tbody>
          {#each dataStore.worksheetRows as row}
            <tr>
              {#each Object.values(row) as val}
                <td>{val}</td>
              {/each}
            </tr>
          {/each}
        </tbody>
      </table>
    {/if}
  </section>

  <!-- Task list from Google Docs -->
  <section class="panel-section">
    <h3>Task List</h3>
    {#if dataStore.tasksState === 'loading'}
      <p class="loading">Loading…</p>
    {:else if dataStore.tasksState === 'error'}
      <p class="error">{dataStore.tasksError}</p>
    {:else if dataStore.tasks.length === 0}
      <p class="empty">No tasks available</p>
    {:else}
      <ul>
        {#each dataStore.tasks as task}
          <li>{task.text}</li>
        {/each}
      </ul>
    {/if}
  </section>
</div>

