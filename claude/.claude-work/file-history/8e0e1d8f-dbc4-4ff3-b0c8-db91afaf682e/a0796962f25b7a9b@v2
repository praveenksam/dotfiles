import type { WorksheetRow } from '../lib/tableau';

export interface TaskItem {
  text: string;
}

type DataLoadState = 'idle' | 'loading' | 'done' | 'error';

/**
 * Extracts the consultant's available open days from Tableau worksheet rows.
 * Looks for a column whose name contains "open" (case-insensitive) in the first row.
 * Returns null if the column is absent, the value is non-numeric, or rows are empty.
 * Column naming convention: "Open Days", "open_days", "Available Days", etc.
 */
export function extractAvailableDays(rows: WorksheetRow[]): number | null {
  if (rows.length === 0) return null;
  const row = rows[0];
  const key = Object.keys(row).find((k) => k.toLowerCase().includes('open'));
  if (!key) return null;
  const val = parseFloat(row[key]);
  return isNaN(val) ? null : val;
}

class DataStore {
  // Tableau worksheet panel
  worksheetRows = $state<WorksheetRow[]>([]);
  worksheetState = $state<DataLoadState>('idle');
  worksheetError = $state<string | null>(null);

  // Consultant's available open days — extracted from worksheetRows on load.
  // null when Tableau data is unavailable (triggers graceful capacity check failure).
  availableDays = $state<number | null>(null);

  // Google Docs task list panel
  tasks = $state<TaskItem[]>([]);
  tasksState = $state<DataLoadState>('idle');
  tasksError = $state<string | null>(null);
}

export const dataStore = new DataStore();
