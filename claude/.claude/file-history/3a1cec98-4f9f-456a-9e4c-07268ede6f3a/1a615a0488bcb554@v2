import uuid

from fastapi import APIRouter

from app.config.workflow_registry import workflow_registry
from app.schemas.config import WorkflowConfigGetResponse
from app.schemas.status import Meta

router = APIRouter(prefix="/api/config", tags=["config"])


@router.get("/workflow", status_code=200, response_model=WorkflowConfigGetResponse)
async def get_workflow_config() -> WorkflowConfigGetResponse:
    """Return the current active workflow config.

    Returns data: None if no config has been uploaded yet.
    No auth required — extension fetches this on load (FR22, FR27).
    """
    return WorkflowConfigGetResponse(
        data=workflow_registry.active_config,
        meta=Meta(request_id=str(uuid.uuid4())),
    )
