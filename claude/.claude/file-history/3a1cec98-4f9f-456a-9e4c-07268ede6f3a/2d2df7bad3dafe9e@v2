import pytest
from httpx import AsyncClient

pytestmark = pytest.mark.asyncio(loop_scope="session")

ADMIN_HEADERS = {"X-Autom9-Token": "test-backend-secret"}

VALID_CONFIG = {
    "version": "1.0.0",
    "workflow_id": "planning",
    "tools": [
        {
            "name": "submit_planning_request",
            "description": "Submit a Smartsheet planning request",
            "parameters": {"type": "object", "properties": {}},
        }
    ],
    "agent_instructions": "You are a planning assistant. Help the consultant schedule their work.",
}


async def test_upload_valid_config_returns_200(client: AsyncClient):
    response = await client.post(
        "/api/admin/config",
        json=VALID_CONFIG,
        headers=ADMIN_HEADERS,
    )
    assert response.status_code == 200
    body = response.json()
    assert body["data"]["version"] == "1.0.0"
    assert body["data"]["workflow_id"] == "planning"
    assert body["data"]["tool_count"] == 1
    assert "request_id" in body["meta"]


async def test_upload_requires_admin_auth(client: AsyncClient):
    response = await client.post("/api/admin/config", json=VALID_CONFIG)
    assert response.status_code == 401


async def test_upload_invalid_version_returns_422(client: AsyncClient):
    bad_config = {**VALID_CONFIG, "version": "not-semver"}
    response = await client.post("/api/admin/config", json=bad_config, headers=ADMIN_HEADERS)
    assert response.status_code == 422


async def test_upload_missing_workflow_id_returns_422(client: AsyncClient):
    bad_config = {k: v for k, v in VALID_CONFIG.items() if k != "workflow_id"}
    response = await client.post("/api/admin/config", json=bad_config, headers=ADMIN_HEADERS)
    assert response.status_code == 422


async def test_upload_missing_tools_returns_422(client: AsyncClient):
    bad_config = {k: v for k, v in VALID_CONFIG.items() if k != "tools"}
    response = await client.post("/api/admin/config", json=bad_config, headers=ADMIN_HEADERS)
    assert response.status_code == 422


async def test_upload_blank_agent_instructions_returns_422(client: AsyncClient):
    bad_config = {**VALID_CONFIG, "agent_instructions": "   "}
    response = await client.post("/api/admin/config", json=bad_config, headers=ADMIN_HEADERS)
    assert response.status_code == 422


async def test_get_workflow_returns_active_config(client: AsyncClient):
    await client.post("/api/admin/config", json=VALID_CONFIG, headers=ADMIN_HEADERS)
    response = await client.get("/api/config/workflow")
    assert response.status_code == 200
    body = response.json()
    assert body["data"]["version"] == "1.0.0"
    assert body["data"]["workflow_id"] == "planning"
    assert "request_id" in body["meta"]


async def test_get_workflow_no_auth_required(client: AsyncClient):
    """GET /api/config/workflow is public — extension fetches without auth."""
    response = await client.get("/api/config/workflow")
    assert response.status_code == 200


async def test_upload_second_config_replaces_first(client: AsyncClient):
    """New upload becomes active; previous config is deactivated (NFR10 infrastructure)."""
    config_v1 = {**VALID_CONFIG, "version": "1.0.0"}
    config_v2 = {**VALID_CONFIG, "version": "2.0.0"}

    await client.post("/api/admin/config", json=config_v1, headers=ADMIN_HEADERS)
    await client.post("/api/admin/config", json=config_v2, headers=ADMIN_HEADERS)

    response = await client.get("/api/config/workflow")
    assert response.json()["data"]["version"] == "2.0.0"


async def test_invalid_upload_preserves_previous_active_config(client: AsyncClient):
    """Failed upload leaves previous active config intact (NFR10, FR27)."""
    await client.post("/api/admin/config", json=VALID_CONFIG, headers=ADMIN_HEADERS)
    bad_config = {**VALID_CONFIG, "version": "bad-version"}
    await client.post("/api/admin/config", json=bad_config, headers=ADMIN_HEADERS)

    response = await client.get("/api/config/workflow")
    assert response.json()["data"]["version"] == "1.0.0"


async def test_only_one_active_config_in_db(client: AsyncClient, db_session):
    """After two uploads, only the latest row has is_active=True."""
    from sqlalchemy import func, select

    from app.models.workflow_config import WorkflowConfig

    config_v1 = {**VALID_CONFIG, "version": "1.0.0"}
    config_v2 = {**VALID_CONFIG, "version": "2.0.0"}
    await client.post("/api/admin/config", json=config_v1, headers=ADMIN_HEADERS)
    await client.post("/api/admin/config", json=config_v2, headers=ADMIN_HEADERS)

    result = await db_session.execute(
        select(func.count()).where(WorkflowConfig.is_active.is_(True))
    )
    assert result.scalar_one() == 1
