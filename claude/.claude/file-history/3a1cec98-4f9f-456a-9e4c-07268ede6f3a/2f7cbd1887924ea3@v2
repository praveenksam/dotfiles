  agent/
    provider.py        # LLMProvider ABC (complete/stream interface)
  config/
    workflow_registry.py  # In-memory singleton for active workflow config
    workflow_schema.py    # Pydantic validation: semver, non-blank fields, tool schema
  core/
    config.py          # pydantic-settings; fails fast on missing/invalid env vars
    exceptions.py      # IntegrationError, ProviderError, MaskingError
  db/
    base.py            # DeclarativeBase with naming conventions
    deps.py            # get_db() — owns commit/rollback, routers use flush() only
    engine.py          # Async engine + session factory
  integrations/
    base.py            # IntegrationBase ABC (health_check never raises, execute raises IntegrationError)
    google_calendar.py
    google_docs.py
    smartsheet.py
    tableau_data.py    # Stub implementations — health checks + execute not yet wired
  models/
    session.py         # Session(session_id UUID, tableau_user_id, started_at)
    credential_store.py  # CredentialStore(org_id, provider, encrypted_key)
    workflow_config.py   # WorkflowConfig(version, config_json, is_active, loaded_at)
    interaction_log.py   # InteractionLog(session_id FK, masked_input/output, tool_calls, latency_ms)
  schemas/             # Pydantic request/response models
  services/
    encryption.py      # Fernet encrypt/decrypt — lazy singleton, never logs plaintext
  main.py              # App entrypoint, CORS, exception handlers, lifespan startup
alembic/
  versions/
    0001_initial_schema.py         # sessions, credential_store, workflow_configs, interaction_logs
