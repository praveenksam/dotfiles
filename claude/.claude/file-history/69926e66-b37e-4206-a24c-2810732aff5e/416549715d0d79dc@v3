import hmac

from fastapi import Header, HTTPException

from app.core.config import settings


async def require_admin(x_autom9_token: str | None = Header(default=None)) -> None:
    """Shared secret guard for all /api/admin/* routes."""
    if not hmac.compare_digest(x_autom9_token or "", settings.BACKEND_SECRET):
        raise HTTPException(status_code=401, detail="Unauthorized")
