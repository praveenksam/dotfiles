<script lang="ts">
  import { apiFetch } from '../lib/api';

  let provider = $state<'openai' | 'anthropic'>('openai');
  let apiKey = $state('');
  let saving = $state(false);
  let saved = $state(false);
  let errorMsg = $state('');

  async function handleSubmit(e: SubmitEvent) {
    e.preventDefault();
    saving = true;
    saved = false;
