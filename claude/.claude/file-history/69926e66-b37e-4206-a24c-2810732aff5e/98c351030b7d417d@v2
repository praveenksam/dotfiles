import pytest
from httpx import AsyncClient

pytestmark = pytest.mark.asyncio(loop_scope="session")


async def test_create_session_returns_session_id(client: AsyncClient):
    response = await client.post(
        "/api/sessions",
        json={"tableau_user_id": "test-user-123"},
    )
    assert response.status_code == 201
    body = response.json()
    assert "data" in body
    assert "session_id" in body["data"]
    assert "started_at" in body["data"]
    assert "request_id" in body["meta"]


async def test_create_session_requires_tableau_user_id(client: AsyncClient):
    response = await client.post("/api/sessions", json={})
    assert response.status_code == 422


async def test_create_session_stores_in_db(client: AsyncClient, db_session):
    from uuid import UUID
    from sqlalchemy import select
    from app.models.session import Session as UserSession

    response = await client.post(
        "/api/sessions",
        json={"tableau_user_id": "db-test-user"},
    )
    assert response.status_code == 201
    session_id = response.json()["data"]["session_id"]
    UUID(session_id)  # raises ValueError if not valid UUID

    # Verify row was actually persisted in the DB
    result = await db_session.execute(
        select(UserSession).where(UserSession.session_id == UUID(session_id))
    )
    row = result.scalar_one_or_none()
    assert row is not None
    assert str(row.session_id) == session_id
