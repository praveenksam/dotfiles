import pytest
from httpx import AsyncClient

pytestmark = pytest.mark.asyncio(loop_scope="session")

SESSION_HEADERS = {"X-Autom9-Session": "test-session-id"}


# ---------------------------------------------------------------------------
# GET /api/data/tasks — no config loaded
# ---------------------------------------------------------------------------


async def test_get_tasks_no_config_returns_404(client: AsyncClient):
    """When no workflow config is loaded, endpoint returns 404."""
    response = await client.get("/api/data/tasks", headers=SESSION_HEADERS)
    assert response.status_code == 404


