# ---------------------------------------------------------------------------
# GET /api/data/tasks — integration stub raises IntegrationError → 503
# ---------------------------------------------------------------------------


async def test_get_tasks_integration_unavailable_returns_503(client: AsyncClient, monkeypatch):
    import app.api.data as data_module
    from app.config.workflow_registry import WorkflowRegistry
    from app.core.exceptions import IntegrationError

    registry = WorkflowRegistry()
    registry._active = {
        "version": "1.0.0",
        "workflow_id": "test",
        "tools": [],
        "agent_instructions": "test",
        "data_panel": {"worksheet_name": "Sheet1", "google_docs_url": "https://docs.example.com/d/abc"},
    }
    monkeypatch.setattr(data_module, "workflow_registry", registry)

    class _FailingDocs:
        async def execute(self, action: str, params: dict) -> dict:
            raise IntegrationError("google_docs", "Google Docs not configured")

    monkeypatch.setattr(data_module, "_google_docs", _FailingDocs())

    response = await client.get("/api/data/tasks", headers=SESSION_HEADERS)
    assert response.status_code == 503


# ---------------------------------------------------------------------------
# GET /api/data/tasks — happy path
# ---------------------------------------------------------------------------


async def test_get_tasks_returns_task_list(client: AsyncClient, monkeypatch):
    import app.api.data as data_module
    from app.config.workflow_registry import WorkflowRegistry

    registry = WorkflowRegistry()
    registry._active = {
        "version": "1.0.0",
        "workflow_id": "test",
        "tools": [],
        "agent_instructions": "test",
        "data_panel": {"worksheet_name": "Sheet1", "google_docs_url": "https://docs.example.com/d/abc"},
    }
    monkeypatch.setattr(data_module, "workflow_registry", registry)

    class _StubDocs:
        async def execute(self, action: str, params: dict) -> dict:
            return {"tasks": ["Review scope", "Update sheet"]}

    monkeypatch.setattr(data_module, "_google_docs", _StubDocs())

    response = await client.get("/api/data/tasks", headers=SESSION_HEADERS)
    assert response.status_code == 200
    body = response.json()
    assert "data" in body
    assert "meta" in body
    assert len(body["data"]) == 2
    assert body["data"][0]["text"] == "Review scope"


