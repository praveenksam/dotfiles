from unittest.mock import AsyncMock, patch

import pytest
from httpx import AsyncClient

from app.agent.provider import LLMResponse

pytestmark = pytest.mark.asyncio(loop_scope="session")

ADMIN_HEADERS = {"X-Autom9-Token": "test-backend-secret"}


# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------


async def test_test_integration_requires_admin(client: AsyncClient):
    response = await client.post("/api/integrations/smartsheet/test")
    assert response.status_code == 401


# ---------------------------------------------------------------------------
# 404 for unknown integration
# ---------------------------------------------------------------------------


async def test_test_unknown_integration_returns_404(client: AsyncClient):
    response = await client.post(
        "/api/integrations/nonexistent/test", headers=ADMIN_HEADERS
    )
