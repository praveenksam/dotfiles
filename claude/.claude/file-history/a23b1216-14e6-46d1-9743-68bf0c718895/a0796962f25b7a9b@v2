import type { WorksheetRow } from '../lib/tableau';

export interface TaskItem {
  text: string;
}

type DataLoadState = 'idle' | 'loading' | 'done' | 'error';

class DataStore {
  // Tableau worksheet panel
  worksheetRows = $state<WorksheetRow[]>([]);
  worksheetState = $state<DataLoadState>('idle');
  worksheetError = $state<string | null>(null);

  // Google Docs task list panel
  tasks = $state<TaskItem[]>([]);
  tasksState = $state<DataLoadState>('idle');
  tasksError = $state<string | null>(null);
}

export const dataStore = new DataStore();
