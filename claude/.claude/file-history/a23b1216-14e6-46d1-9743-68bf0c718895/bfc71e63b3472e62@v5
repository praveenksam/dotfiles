### [x] Task 2 — Add `getWorksheetData()` to `autom9-extension/src/lib/tableau.ts`

Extend `tableau.ts` with a worksheet-reading function. The Tableau Extensions API exposes worksheets via `window.tableau.extensions.dashboardContent.dashboard.worksheets`.

```typescript
export interface WorksheetRow {
  [fieldName: string]: string;
}

/**
 * Reads summary data from a named Tableau worksheet.
 * Returns an array of row objects keyed by field name (formattedValue).
 * Throws an Error if the worksheet is not found or data cannot be retrieved.
 * Returns [] immediately when no Tableau runtime is present (dev/test).
 */
export async function getWorksheetData(worksheetName: string): Promise<WorksheetRow[]> {
  if (typeof window === 'undefined' || !window.tableau) {
    // Dev/test: no Tableau runtime — return empty data
    return [];
  }

  const extensions = window.tableau.extensions as unknown as {
    dashboardContent?: {
      dashboard?: {
        worksheets?: Array<{
          name: string;
          getSummaryDataAsync: () => Promise<{
            columns: Array<{ fieldName: string }>;
            data: Array<Array<{ formattedValue: string }>>;
          }>;
        }>;
      };
    };
  };

  const worksheets = extensions.dashboardContent?.dashboard?.worksheets ?? [];
  const worksheet = worksheets.find((w) => w.name === worksheetName);
  if (!worksheet) {
    throw new Error(`Worksheet "${worksheetName}" not found in dashboard`);
  }

  const dataTable = await worksheet.getSummaryDataAsync();
  const columns = dataTable.columns.map((c) => c.fieldName);
  return dataTable.data.map((row) =>
    Object.fromEntries(columns.map((col, i) => [col, row[i]?.formattedValue ?? '']))
  );
}
```

**Dev note:** `@tableau/extensions-api-types` is installed but the type definitions may not fully cover `dashboardContent`. Use the `as unknown as ...` cast pattern already established in `getTableauUserId()` to avoid missing type errors.

