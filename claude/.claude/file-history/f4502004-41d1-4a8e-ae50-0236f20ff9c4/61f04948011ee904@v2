def test_tools_to_openai_wraps_in_function_type():
    tools = [{"name": "my_tool", "description": "desc", "parameters": {"type": "object"}}]
    result = _tools_to_openai(tools)
    assert len(result) == 1
    assert result[0]["type"] == "function"
    assert result[0]["function"]["name"] == "my_tool"
    assert result[0]["function"]["description"] == "desc"
    assert result[0]["function"]["parameters"] == {"type": "object"}


def test_tools_to_openai_empty_list():
    assert _tools_to_openai([]) == []


def test_parse_tool_calls_parses_arguments_json_string():
    raw = [
        {
            "id": "call_abc",
            "type": "function",
            "function": {"name": "submit_planning_request", "arguments": '{"date": "2026-05-01"}'},
        }
    ]
    result = _parse_tool_calls(raw)
    assert len(result) == 1
    assert result[0]["id"] == "call_abc"
    assert result[0]["name"] == "submit_planning_request"
    assert result[0]["arguments"] == {"date": "2026-05-01"}  # dict, not string


def test_parse_tool_calls_handles_malformed_json():
    raw = [{"id": "c1", "type": "function", "function": {"name": "t", "arguments": "not-json"}}]
    result = _parse_tool_calls(raw)
    assert result[0]["arguments"] == {}


def test_parse_tool_calls_none_returns_empty():
    assert _parse_tool_calls(None) == []


def test_parse_tool_calls_empty_list():
    assert _parse_tool_calls([]) == []


def test_normalize_finish_reason_known_values():
    assert _normalize_finish_reason("stop") == "stop"
    assert _normalize_finish_reason("tool_calls") == "tool_calls"
    assert _normalize_finish_reason("length") == "length"
    assert _normalize_finish_reason("content_filter") == "content_filter"


def test_normalize_finish_reason_none():
    assert _normalize_finish_reason(None) == "stop"


