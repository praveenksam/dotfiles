@pytest.mark.asyncio
async def test_complete_returns_text_response():
    provider = OpenAIProvider(api_key="test-key")
    expected = LLMResponse(content="Hello!", tool_calls=[], finish_reason="stop")
    with patch.object(provider, "_call_api", new=AsyncMock(return_value=expected)):
        result = await provider.complete([{"role": "user", "content": "Hi"}], [])
    assert result.content == "Hello!"
    assert result.tool_calls == []
    assert result.finish_reason == "stop"


@pytest.mark.asyncio
async def test_complete_passes_tools_when_provided():
    provider = OpenAIProvider(api_key="test-key")
    expected = LLMResponse(content="ok", tool_calls=[], finish_reason="stop")
    captured_payload = {}

    async def capture(payload):
        captured_payload.update(payload)
        return expected

    with patch.object(provider, "_call_api", new=capture):
        await provider.complete(
            [{"role": "user", "content": "Hi"}],
            [{"name": "my_tool", "description": "d", "parameters": {}}],
        )

    assert "tools" in captured_payload
    assert captured_payload["tools"][0]["type"] == "function"


