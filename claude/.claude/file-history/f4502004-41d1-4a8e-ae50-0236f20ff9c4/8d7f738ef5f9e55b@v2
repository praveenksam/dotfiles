@pytest.mark.asyncio
async def test_complete_retries_on_529_overloaded():
    provider = AnthropicProvider(api_key="test-key")
    call_count = 0

    async def flaky(payload):
        nonlocal call_count
        call_count += 1
        if call_count < 2:
            raise _ProviderHTTPError(529, "overloaded")
        return LLMResponse(content="ok", tool_calls=[], finish_reason="stop")

    with patch.object(provider, "_call_api", new=flaky):
        with patch("asyncio.sleep", new=AsyncMock()):
            result = await provider.complete([{"role": "user", "content": "Hi"}], [])

    assert call_count == 2
    assert result.content == "ok"


@pytest.mark.asyncio
async def test_complete_retries_on_429():
    provider = AnthropicProvider(api_key="test-key")
    call_count = 0

    async def flaky(payload):
