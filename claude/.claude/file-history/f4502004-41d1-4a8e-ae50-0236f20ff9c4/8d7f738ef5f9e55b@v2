def test_split_system_messages_extracts_system_content():
    messages = [
        {"role": "system", "content": "You are a planner."},
        {"role": "user", "content": "Hello"},
    ]
    system, filtered = _split_system_messages(messages)
    assert system == "You are a planner."
    assert len(filtered) == 1
    assert filtered[0]["role"] == "user"


def test_split_system_messages_no_system_returns_none():
    messages = [{"role": "user", "content": "Hello"}]
    system, filtered = _split_system_messages(messages)
    assert system is None
    assert len(filtered) == 1


def test_split_system_messages_multiple_system_joined():
    messages = [
        {"role": "system", "content": "Part 1."},
        {"role": "system", "content": "Part 2."},
        {"role": "user", "content": "Hi"},
    ]
    system, filtered = _split_system_messages(messages)
    assert system == "Part 1.\nPart 2."
    assert len(filtered) == 1


def test_split_system_messages_empty_list():
    system, filtered = _split_system_messages([])
    assert system is None
    assert filtered == []


def test_tools_to_anthropic_uses_input_schema_not_parameters():
    tools = [{"name": "t", "description": "d", "parameters": {"type": "object", "properties": {}}}]
    result = _tools_to_anthropic(tools)
    assert len(result) == 1
    assert "input_schema" in result[0]
    assert "parameters" not in result[0]
    assert result[0]["input_schema"] == {"type": "object", "properties": {}}
    assert result[0]["name"] == "t"
    assert result[0]["description"] == "d"


def test_tools_to_anthropic_empty_list():
    assert _tools_to_anthropic([]) == []


def test_tools_to_anthropic_defaults_input_schema_when_no_parameters():
    tools = [{"name": "t", "description": "d"}]
    result = _tools_to_anthropic(tools)
    assert result[0]["input_schema"] == {"type": "object", "properties": {}}


def test_parse_content_text_only():
    blocks = [{"type": "text", "text": "Hello!"}]
    text, tool_calls = _parse_content(blocks)
    assert text == "Hello!"
    assert tool_calls == []


def test_parse_content_tool_use_input_is_already_dict():
    blocks = [{"type": "tool_use", "id": "tu1", "name": "my_tool", "input": {"key": "val"}}]
    text, tool_calls = _parse_content(blocks)
    assert text == ""
    assert len(tool_calls) == 1
    assert tool_calls[0]["arguments"] == {"key": "val"}  # input dict, NOT a JSON string
    assert tool_calls[0]["name"] == "my_tool"
    assert tool_calls[0]["id"] == "tu1"


def test_parse_content_mixed_text_and_tool():
    blocks = [
        {"type": "text", "text": "I'll help."},
        {"type": "tool_use", "id": "tu1", "name": "submit", "input": {"x": 1}},
    ]
    text, tool_calls = _parse_content(blocks)
    assert text == "I'll help."
    assert len(tool_calls) == 1
    assert tool_calls[0]["arguments"] == {"x": 1}


def test_parse_content_empty():
    text, tool_calls = _parse_content([])
    assert text == ""
    assert tool_calls == []


