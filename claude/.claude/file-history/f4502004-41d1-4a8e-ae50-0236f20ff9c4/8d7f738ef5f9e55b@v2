        return LLMResponse(content="ok", tool_calls=[], finish_reason="stop")

    with patch.object(provider, "_call_api", new=flaky):
        with patch("asyncio.sleep", new=AsyncMock()):
            result = await provider.complete([{"role": "user", "content": "Hi"}], [])

    assert call_count == 3


@pytest.mark.asyncio
async def test_complete_raises_provider_error_after_max_retries():
    provider = AnthropicProvider(api_key="test-key")

    async def always_fail(payload):
        raise _ProviderHTTPError(500, "server error")

    with patch.object(provider, "_call_api", new=always_fail):
        with patch("asyncio.sleep", new=AsyncMock()):
            with pytest.raises(ProviderError) as exc_info:
                await provider.complete([{"role": "user", "content": "Hi"}], [])

    assert exc_info.value.provider == "anthropic"
    assert "Max retries exceeded" in str(exc_info.value)


@pytest.mark.asyncio
async def test_complete_raises_immediately_on_non_transient_401():
    provider = AnthropicProvider(api_key="bad-key")
    call_count = 0

    async def auth_fail(payload):
        nonlocal call_count
        call_count += 1
        raise _ProviderHTTPError(401, "unauthorized")

    with patch.object(provider, "_call_api", new=auth_fail):
        with pytest.raises(ProviderError):
            await provider.complete([{"role": "user", "content": "Hi"}], [])

    assert call_count == 1  # no retries on 401


