# Background
background = 000000
background-opacity = 0.9
background-blur-radius = 20

# Font
font-family = JetBrainsMono Nerd Font Mono
# font-family = Fira Code
font-size = 14
# font-thicken = true
adjust-cell-height = 5%

# Theme
theme = Brogrammer

# Nice extras
window-padding-x = 12
window-padding-y = 12
cursor-style = block
